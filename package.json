{
  "name": "ask-user-question-mcp-server",
  "version": "0.2.1",
  "description": "Extended AskUserQuestion as an MCP server: accepts unlimited structured questions and collects answers via a local web UI",
  "license": "MIT",
  "author": "KokiKono",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KokiKono/askUserQuestionMCPServer.git"
  },
  "homepage": "https://github.com/KokiKono/askUserQuestionMCPServer#readme",
  "bugs": {
    "url": "https://github.com/KokiKono/askUserQuestionMCPServer/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ask-user-question",
    "questionnaire"
  ],
  "type": "module",
  "bin": {
    "ask-user-question-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
